{
  "expo": {
    "name": "RISE",
    "slug": "rise",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "app.rise.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "RISE записывает видео-кружок во время утреннего испытания. Видео остаётся на твоём устройстве, пока ты сам не решишь им поделиться.",
        "NSPhotoLibraryAddUsageDescription": "Чтобы сохранить видео своей утренней победы в галерею.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "app.rise.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#D6F84C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "RISE записывает видео-кружок во время утреннего испытания. Видео остаётся у тебя на устройстве.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D6F84C"
        }
      ]
    ]
  }
}
