{
  "name": "rise",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run -w @rise/mobile",
    "start": "npm run start -w @rise/mobile",
    "android": "npm run android -w @rise/mobile",
    "ios": "npm run ios -w @rise/mobile",
    "typecheck": "npm run typecheck -w @rise/mobile -w @rise/shared",
    "test:money": "node --experimental-strip-types --test 'supabase/functions/_shared/*_test.ts'",
    "test:rls": "./supabase/tests/run.sh",
    "test": "npm run test:money && npm run test:alarm && npm run test:rls",
    "test:alarm": "node --experimental-strip-types --test 'apps/mobile/src/features/alarm/*_test.ts'"
  }
}
